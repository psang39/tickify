{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:event-images": "tsx src/scripts/migrateEventImages.ts",
    "perf:seed": "tsx src/scripts/seed-performance.ts",
    "perf:prepare": "tsx src/scripts/seed-performance.ts",
    "perf:verify-queue": "tsx src/scripts/verify-performance-queue-isolation.ts",
    "perf:verify": "tsx src/scripts/verify-performance-invariants.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test --test-concurrency=1 test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts test/e2e/*.test.ts",
    "test:kafka": "node --import tsx --test --test-concurrency=1 test/integration/kafka.integration.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-concurrency=1 test/unit/*.test.ts test/integration/*.test.ts test/e2e/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.1.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@otp-lib/authenticator": "^0.2.1",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.5",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "ioredis": "^5.10.1",
    "jiti": "^2.6.1",
